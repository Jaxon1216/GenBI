# ===== GenBI Go 后端配置样例 =====
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）

# HTTP 服务端口（必须为 8080，前端 dev 代理写死 /api -> http://localhost:8080）
PORT=8080

# MySQL DSN（GORM）。请先创建数据库并执行 sql/create_table.sql
DB_DSN=root:password@tcp(localhost:3306)/genbi?charset=utf8mb4&parseTime=True&loc=Local

# Redis（会话存储 + 限流）
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# RabbitMQ（异步图表生成）
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# DeepSeek AI（缺失时同步/异步生成会返回失败，但不影响服务启动与其它接口）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 会话
SESSION_SECRET=please-change-this-secret
SESSION_MAX_AGE=2592000
