# ===== GenBI Go 后端配置样例 =====
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）

# HTTP 服务端口（必须为 8080，前端 dev 代理写死 /api -> http://localhost:8080）
PORT=8080

# MySQL DSN（GORM）。
# 默认值对应仓库根目录 docker-compose.yml 中的 MySQL（root/123，库 genbi，端口 3306）。
# 如果你改了 compose 里的 MYSQL_ROOT_PASSWORD，这里的密码必须同步修改，否则后端启动即退出。
# 若使用本机自装的 MySQL，请先创建数据库并执行 sql/create_table.sql + sql/02_outbox.sql。
DB_DSN=root:123@tcp(localhost:3306)/genbi?charset=utf8mb4&parseTime=True&loc=Local

# Redis（会话存储 + 限流）。默认对应 docker-compose.yml 的 redis 服务。
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# RabbitMQ（异步图表生成）。默认对应 docker-compose.yml 的 rabbitmq 服务。
# 连不上不会阻止后端启动，但 /chart/gen/async 与 outbox 补发不可用；管理台：http://localhost:15672（guest/guest）。
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# DeepSeek AI（缺失时同步/异步生成会返回失败，但不影响服务启动与其它接口）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 会话
SESSION_SECRET=please-change-this-secret
SESSION_MAX_AGE=2592000
